# MongoDB connection string (Atlas SRV URI or local Mongo)
MONGODB_URI=mongodb://127.0.0.1:27017/pss
# Secret used to sign JWTs (HS256). Use a long random string.
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime (jose format, e.g. 15m, 12h, 7d)
JWT_EXPIRES_IN=7d
# Airline designator and 3-digit ticket prefix (used for 13-digit ticket numbers)
AIRLINE_CODE=PS
AIRLINE_TICKET_PREFIX=123

# Secret for the scheduled sweep (GET /api/cron/sweep). Vercel Cron sends it as Authorization: Bearer <value>.
# The endpoint always returns 401 when this is unset. Use a long random string, different from JWT_SECRET.
CRON_SECRET=change-me-to-another-long-random-string
